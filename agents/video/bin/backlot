#!/usr/bin/env bash
# Launcher for the backlot CLI. Resolves symlinks so it works from ~/.local/bin.
set -euo pipefail
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ "$self" != /* ]] && self="$dir/$self"
done
root="$(cd -P "$(dirname "$self")/.." && pwd)"
exec uv run --quiet --project "$root/backlot" python -m backlot "$@"
