{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/agents/video/claude/hooks/confirm-spend.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__higgsfield__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/agents/video/claude/hooks/confirm-higgsfield-mcp.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
