{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp==1.9.1"],
      "env": { "DISABLE_TELEMETRY": "true" }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "godot": {
      "command": "uvx",
      "args": ["godot-ai==4.0.4", "attach", "--disable-telemetry"],
      "env": { "GODOT_AI_DISABLE_TELEMETRY": "true" }
    },
    "fal": {
      "command": "/Users/konstantin/.local/bin/fal-mcp-codg"
    }
  }
}
