[init]
	defaultBranch = main
[alias]
	pfush = push --force-with-lease
	pfushx = push --force
[push]
	default = current
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[include]
	path = ~/.config/dotfiles/git.local
